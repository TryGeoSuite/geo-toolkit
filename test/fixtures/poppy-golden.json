{
  "_about": "Golden cases for the poppy.json check of @geosuite/poppy-json (src/check.js) and GeoSuite's audit (backend/services/ingestion/personal_agent_protocol.py). Both repos run every case; GeoSuite keeps a byte-identical copy in backend/tests/fixtures/poppy_json_golden.json. Field names are the audit's (snake_case); the JS test maps them. A route answers with {status (default 200), json | body | oversize (a JSON body over 256 KB), location} or raises ('fetch' or 'timeout'); any other URL answers 404.",
  "issue_codes": [
    "not_an_object",
    "missing_protocol_version",
    "unsupported_major_version",
    "missing_organization",
    "domain_mismatch",
    "invalid_agent_protocol",
    "invalid_api_entry",
    "invalid_browser_session_endpoint",
    "no_channels",
    "missing_auth_issuer",
    "not_https",
    "issuer_metadata_unreachable",
    "issuer_metadata_invalid",
    "issuer_mismatch",
    "domain_not_in_issuer",
    "missing_token_endpoint",
    "missing_revocation_endpoint",
    "missing_authorization_endpoint",
    "missing_device_authorization_endpoint"
  ],
  "validate_cases": [
    {
      "name": "a complete document is valid",
      "document": {
        "protocol_version": "0.1",
        "organization": {
          "name": "Acme",
          "domain": "acme.it"
        },
        "auth": {
          "issuer": "https://auth.acme.it",
          "direct": {
            "scopes": [
              "poppy:read",
              "poppy:write"
            ]
          }
        },
        "agent": {
          "protocols": [
            {
              "type": "poppy",
              "endpoint": "https://acme.it/poppy"
            }
          ]
        },
        "apis": [
          {
            "type": "mcp",
            "url": "https://acme.it/mcp",
            "description": "Ordini"
          }
        ]
      },
      "host": "www.acme.it",
      "expected": {
        "valid": true,
        "issues": [],
        "protocol_version": "0.1",
        "organization_domain": "acme.it",
        "issuer": "https://auth.acme.it",
        "sign_in_types": [
          "direct"
        ],
        "api_types": [
          "mcp"
        ],
        "has_conversation": true,
        "has_browser_session": false
      }
    },
    {
      "name": "the domain must match the requested host",
